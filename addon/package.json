{
  "name": "@rottenbox/addon",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Find torrent streams for movies and TV shows while browsing Rotten Tomatoes, Letterboxd and Metacritic.",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "BROWSER=firefox vite",
    "build": "tsc -b && bun run build:chrome && bun run build:firefox",
    "build:chrome": "BROWSER=chrome vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "lint:firefox": "web-ext lint --self-hosted -s dist/firefox",
    "start:firefox": "web-ext run -s dist/firefox",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.1.37",
    "@types/node": "^25.5.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.11",
    "vite-plugin-zip-pack": "^1.2.4",
    "web-ext": "^10.8.0"
  }
}
